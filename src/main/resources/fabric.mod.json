  "authors": ["EazyIf"],
  "contact": {
    "homepage": "https://github.com/eazyif/minec-would-you",
    "sources": "https://github.com/eazyif/minec-would-you"
  },
  "license": "MIT",
  "icon": "assets/wouldyou/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.eazyif.wouldyou.WouldYouRatherMod"],
    "client": ["com.eazyif.wouldyou.client.WouldYouRatherClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
